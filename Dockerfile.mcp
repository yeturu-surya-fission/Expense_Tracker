FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --only-group mcp --no-install-project
ENV PATH="/srv/.venv/bin:$PATH"
COPY alembic.ini .
COPY mcp_server ./mcp_server
RUN useradd --system --uid 10001 app && chown -R app /srv
USER app
EXPOSE 8001
# migrate, then serve (MCP_PUBLIC_URL's port decides where uvicorn listens; default 8001)
CMD ["sh", "-c", "alembic upgrade head && python -m mcp_server"]
