FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements-finance.txt .
RUN pip install --no-cache-dir -r requirements-finance.txt
COPY finance_agent ./finance_agent
RUN useradd --system --uid 10003 app && chown -R app /srv
USER app
EXPOSE 8002
CMD ["python", "-m", "finance_agent"]
