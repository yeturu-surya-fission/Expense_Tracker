# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# comma separated Telegram user ids allowed to use the bot (get yours from @userinfobot). Empty = everyone.
# Friends you add (or invite) can use the bot too, even if they are not listed here.
ALLOWED_TELEGRAM_IDS=
# polling (local/dev) or webhook (production, needs PUBLIC_URL with https)
TELEGRAM_MODE=polling
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=change-me

# --- CodeVector (the only LLM gateway; OpenAI-compatible endpoint) ---
CODEVECTOR_API_KEY=
# Full OpenAI-compatible base URL, including the gateway path. Example:
#   https://coding-gateway.fissionlabs.com/gateway/openai/v1
# Do NOT use the bare host or `<host>/v1` - the chat endpoint lives under /gateway/openai/v1.
CODEVECTOR_BASE_URL=
# Model slug exposed by the gateway (required)
CODEVECTOR_MODEL=dev-model-alpha

# --- Database (a NEW database for this version; docker-compose sets it for you) ---
DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense_tracker

# --- Behaviour ---
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata
BUDGET_ALERT_THRESHOLDS=50,80,100
# how often an unpaid share is re-sent to the person who owes it
REMINDER_EVERY_HOURS=48
# a split with this many people (you + friends) first asks: one-off split, or create a group?
ASK_GROUP_MIN_PEOPLE=4

# --- MCP auth (Ed25519 keypair; generate once with: python scripts/generate_mcp_keys.py) ---
# MCP_PRIVATE_KEY is read ONLY by the backend (app/auth/keys.py) - it signs tokens for the MCP server.
# MCP_PUBLIC_KEY is read ONLY by the MCP server (mcp_server/auth/keys.py) - it verifies tokens, can never mint.
# Never put the private key in the MCP server's environment.
MCP_PRIVATE_KEY=
MCP_PUBLIC_KEY=
# where the backend agent finds the MCP server (phase 8 client adapter reads this)
MCP_SERVER_URL=http://localhost:9000/mcp
