# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# comma separated Telegram user ids allowed to use the bot (get yours from @userinfobot). Empty = everyone.
# Friends you add (or invite) can use the bot too, even if they are not listed here.
ALLOWED_TELEGRAM_IDS=
# polling (local/dev) or webhook (production, needs PUBLIC_URL with https)
TELEGRAM_MODE=polling
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=change-me

# --- LLM brain: put ANY one key. Provider is auto-detected from the key ---
#   AIza... or AQ. -> Gemini    sk-ant-... -> Anthropic    gsk_... -> Groq    sk-... -> OpenAI
LLM_API_KEY=
# LLM_PROVIDER: auto | gemini | openai | anthropic | groq
LLM_PROVIDER=auto
# LLM_MODEL: leave empty for the default of each provider
LLM_MODEL=

# --- Database (a NEW database for this version; docker-compose sets it for you) ---
DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense_tracker

# --- Behaviour ---
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata
BUDGET_ALERT_THRESHOLDS=50,80,100
# how often an unpaid share is re-sent to the person who owes it
REMINDER_EVERY_HOURS=48
# a split with this many people (you + friends) first asks: one-off split, or create a group?
ASK_GROUP_MIN_PEOPLE=4
