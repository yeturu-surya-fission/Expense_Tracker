# ======================= shared between the two services =======================
# A long random string the bot uses to prove who it is to the MCP server (generate:  python -c "import secrets; print(secrets.token_urlsafe(48))")
MCP_BOT_CLIENT_SECRET=
# comma separated Telegram user ids allowed to use the bot (get yours from @userinfobot). Empty = everyone.
# Friends you add (or invite) can use the bot too. The MCP server enforces this, the bot only asks.
ALLOWED_TELEGRAM_IDS=

# ======================= Telegram bot (app/) =======================
# create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# polling (local/dev) or webhook (production, needs PUBLIC_URL with https)
TELEGRAM_MODE=polling
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=change-me

# LLM brain: put ANY one key. Provider is auto-detected from the key
#   AIza... or AQ. -> Gemini    sk-ant-... -> Anthropic    gsk_... -> Groq    sk-... -> OpenAI
LLM_API_KEY=
# LLM_PROVIDER: auto | gemini | openai | anthropic | groq
LLM_PROVIDER=auto
# LLM_MODEL: leave empty for the default of each provider
LLM_MODEL=

# where the bot finds the MCP server (docker-compose sets this for you)
MCP_SERVER_URL=http://localhost:8001/mcp
# the bot's own database: ONLY the AI conversation state (history + paused questions)
BOT_DATABASE_URL=postgresql://expense:expense@localhost:5432/expense_bot

# ======================= MCP server (mcp_server/) =======================
# its own database: all expense data
MCP_DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense_mcp
# dev = a throw-away signing key is generated at start; production = MCP_JWT_PRIVATE_KEY is required
MCP_ENV=dev
# the address clients use to reach the server (its tokens are bound to <MCP_PUBLIC_URL>/mcp)
MCP_PUBLIC_URL=http://localhost:8001
# production signing key (PEM, newlines as \n). Create one:  python -m mcp_server.auth.genkey
MCP_JWT_PRIVATE_KEY=
# token lifetimes
MCP_SERVICE_TOKEN_TTL_MINUTES=10
MCP_SESSION_TOKEN_TTL_MINUTES=30
# extra browser origins / host names allowed to call the server (comma separated); normally empty
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=

# ======================= Behaviour (read by the MCP server; TIMEZONE also by the bot) =======================
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata
BUDGET_ALERT_THRESHOLDS=50,80,100
# how often an unpaid share is re-sent to the person who owes it
REMINDER_EVERY_HOURS=48
# a split with this many people (you + friends) first asks: one-off split, or create a group?
ASK_GROUP_MIN_PEOPLE=4
